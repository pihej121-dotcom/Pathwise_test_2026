# ============================================================
# Pathwise Institution Edition — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit real secrets to version control.
# ============================================================

# ------------------------------------------------------------
# Database (Supabase PostgreSQL)
# ------------------------------------------------------------
# Pooled connection string — used by the app at runtime.
# Supabase: Settings → Database → Transaction pooler URI (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Direct (non-pooled) connection string — used only by Drizzle migrations (db:push).
# DDL statements must use this URL, NOT the transaction pooler (port 6543).
#
# Option A — Direct connection (port 5432). Requires IPv6 on some networks:
#   DIRECT_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
#
# Option B — Session pooler (port 5432, supports IPv4). Use if Option A fails:
#   Supabase → Settings → Database → Session pooler connection string
#   DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true
#
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------
SESSION_SECRET=replace-with-a-long-random-string

# ------------------------------------------------------------
# AI — OpenAI
# ------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ------------------------------------------------------------
# Payments — Stripe
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Subscription price IDs (from Stripe Dashboard → Products)
STRIPE_PRICE_ID=price_...

# Individual feature price IDs
STRIPE_PRICE_ID_INTERVIEW_PREP=price_...
STRIPE_PRICE_ID_SALARY_NEGOTIATOR=price_...
STRIPE_PRICE_ID_MICRO_PROJECT=price_...
STRIPE_PRICE_ID_CAREER_ROADMAP=price_...
STRIPE_PRICE_ID_JOB_MATCH=price_...
STRIPE_PRICE_ID_RESUME_ANALYSIS=price_...

# ------------------------------------------------------------
# Email — Resend
# ------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Pathwise <noreply@pathwise.nyc>

# ------------------------------------------------------------
# File Storage — Supabase Storage
# ------------------------------------------------------------
# Supabase: Settings → API → Project URL
SUPABASE_URL=https://[project-ref].supabase.co

# Supabase: Settings → API → service_role key (keep secret — server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Name of the Supabase Storage bucket for resume uploads (default: resumes)
SUPABASE_STORAGE_BUCKET=resumes

# ------------------------------------------------------------
# Application URL
# ------------------------------------------------------------
# Production: https://pathwise.nyc
# Development: http://localhost:5000
APP_URL=https://pathwise.nyc

# ------------------------------------------------------------
# Optional — Job APIs
# ------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
CORESIGNAL_API_KEY=

# ------------------------------------------------------------
# Optional — Web Search
# ------------------------------------------------------------
SEARXNG_URL=https://searxng-production-9a5e.up.railway.app
